# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs / package managers
.venv/
venv/
.uv/

# Generated gRPC stubs
radp/common/proto/*_pb2.py
radp/common/proto/*_pb2.pyi
radp/common/proto/*_pb2_grpc.py

# Model / cache artifacts
*.bin
*.safetensors
.cache/
hf_cache/
.jetson_cache/

# Experiment outputs
results/
logs/
*.log

# Editor
.vscode/*
# Keep the workspace LaTeX build config so the paper builds out of the
# box when contributors check the repo out on a new machine.
!.vscode/settings.json
.idea/
.DS_Store

# Claude Code runtime artifacts
.claude/scheduled_tasks.lock
.claude/plans/

# Ansible deployment — actual configs (only .example files are tracked)
deploy/inventory.ini
deploy/group_vars/all.yml
.venv-*/

# Generated artifacts
experiments/REPORT.html

# PPT Slides — 주차별 덱과 원본 대용량 파일은 추적하지 않는다.
# 단 규격(DESIGN_SYSTEM.md)과 빈 템플릿은 추적한다: 서식이 바뀐 이유가
# 커밋에 남아야 매주 같은 결과가 나온다.
# (디렉터리 자체를 제외하면 하위 파일을 되살릴 수 없으므로 `ppt/*` 형태를 쓴다.)
ppt/*
!ppt/DESIGN_SYSTEM.md
!ppt/template/
ppt/template/*
!ppt/template/radp-progress-template.pptx

# Reference paper PDFs — local corpus only; catalog .md files ARE tracked.
# (Public repo: avoid bloat + copyrighted-PDF redistribution.)
paper/refs/*.pdf
