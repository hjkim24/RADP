# RADP fleet vars. Copy to all.yml and edit.

# ---- Repo + install location ------------------------------------------------
radp_repo_url: "https://github.com/hjkim24/RADP.git"
radp_ref: "main"
radp_install_dir: "/home/{{ ansible_user }}/radp"

# Override per-host in inventory for JetPack 5 boards (Ubuntu 20.04) — they
# need explicit `python3.9` since their default `python3` is 3.8, which
# radp's >=3.9 requirement rejects.
radp_python_executable: "python3"

# ---- Jetson-specific PyTorch wheel ------------------------------------------
# Pick the wheel matching your JetPack version from NVIDIA's index:
#   JetPack 6 (Python 3.10, CUDA 12.x):
#     https://developer.download.nvidia.com/compute/redist/jp/v60/pytorch/
#   JetPack 5 (Python 3.8):  use that index (and bump Python in radp pyproject)
#
# Leave unset → assume torch is already installed system-wide (e.g., via
# NVIDIA NGC container). The play will detect+warn.
jetson_torch_wheel_url: ""

# ---- Model + device ---------------------------------------------------------
model_id: "facebook/opt-125m"
model_dtype: "float16"           # float32 / float16 / bfloat16
model_torch_device: "cuda"        # cpu / cuda

# Reported in worker heartbeats so the coordinator can group/identify
# heterogeneous hardware (used by Phase D2+ for DeviceProfile inference).
# Leave empty if all workers are interchangeable.
device_class: "jetson-orin-nano-4gb"

# ---- Ports + heartbeat ------------------------------------------------------
radp_worker_port: 50051
radp_coord_port: 50050
heartbeat_timeout_seconds: 5.0
heartbeat_tick_seconds: 1.0

# Coordinator dashboard (read-only HTTP). 0 disables.
# When enabled, point your browser at http://<coord-host>:<coord_web_port>/
# from anywhere inside the lab VPN. Daemon thread inside the same
# radp-coordinator process — no extra systemd unit.
coord_web_port: 8080

# ---- Scheduling mode (Phase D3) --------------------------------------------
# "auto"   — coordinator profiles the fleet at startup (ProfileLayers +
#            MeasurePeer) and computes Ψ + R via the Recovery-Aware DP.
#            cluster_placement / cluster_recovery below are IGNORED.
# "manual" — you set cluster_placement + cluster_recovery yourself; the
#            coordinator deploys exactly what you specify.
schedule_mode: "auto"

# SLO bounds used as DP constraints (auto mode only; ignored in manual)
slo_ttft_seconds: 0.3
slo_tbt_seconds: 0.1
activation_bytes: 1048576    # rough per-stage activation size in bytes

# Profiling knobs (auto mode only). Defaults are sensible for OPT-style
# models on edge hardware; tune up if you want tighter measurement.
profiling_layer_warmup: 1
profiling_layer_repeats: 3
profiling_layer_seq_length: 32
profiling_network_payload_bytes: 1048576
profiling_network_rounds: 10
profiling_wait_timeout_seconds: 60.0

# ---- Manual placement / recovery -------------------------------------------
# Only used when schedule_mode == "manual". You can remove these blocks
# entirely in auto mode. Example below splits 12 layers across 3 workers.
cluster_placement:
  - device: jetson-1
    start: 1
    end: 4
  - device: jetson-2
    start: 5
    end: 8
  - device: jetson-3
    start: 9
    end: 12

cluster_recovery:
  jetson-1: jetson-2
  jetson-2: jetson-3
  jetson-3: jetson-1
